-- §23 : `RaceFact.current_version_id` pointe vers la version courante. Sans
-- ce pointeur, le fact publié n'aurait pas de valeur courante et toute
-- comparaison à « la valeur publiée » porterait sur du vide.
update public.race_facts
set current_version_id = 'aaaaaaaa-0000-4000-8000-000000000094'
where id = 'aaaaaaaa-0000-4000-8000-000000000093';

