# ============================================================
# PLUKA — variables d'environnement
# ============================================================
# Copier en .env.local pour le développement.
#
# RÈGLE ABSOLUE : tout ce qui est préfixé NEXT_PUBLIC_ est envoyé au navigateur.
# Aucun secret ne doit jamais recevoir ce préfixe.
# SUPABASE_SERVICE_ROLE_KEY n'existe que dans apps/worker, les Server Actions
# et les Route Handlers. Jamais dans un projet Vercel qui n'en a pas besoin.

# ---------- Supabase (public, navigateur) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Supabase (serveur uniquement) ----------
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------- Applications ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# ---------- Providers externes (interfaces abstraites) ----------
# Aucun moteur ne lit ces variables directement : seuls les adapters le font.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

WEATHER_PROVIDER=
WEATHER_API_KEY=

EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# ---------- Observabilité ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Feature flags ----------
# Voir docs/01_ARCHITECTURE.md §41. Un flag n'est pas un entitlement.
FLAG_REPERE_PLUKA=false
FLAG_RACE_INTELLIGENCE=false
FLAG_COMMUNITY=false
FLAG_ADVANCED_OFFLINE=false
